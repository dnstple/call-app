# Copy to .env.automation (git-ignored). Used ONLY by the local automation CLIs
# (npm run contact / outreach / graph:selftest). No Anthropic API key:
# triage runs in a scheduled Claude Code session on your normal plan usage. Never ship these to the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft Graph — app registration scoped to info@apricoti.co.uk ONLY
# (docs/automation/GRAPH_SETUP.md). MS_GRAPH_MAILBOX must be exactly info@apricoti.co.uk;
# any other value is refused by the code.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_MAILBOX=info@apricoti.co.uk
